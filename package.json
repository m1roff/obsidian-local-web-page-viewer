{
  "name": "local-web-page-viewer",
  "version": "0.1.0",
  "description": "Opens local .html files as real rendered pages, with working CSS, images and video - on desktop and mobile alike.",
  "main": "main.js",
  "private": true,
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
    "typecheck": "tsc -noEmit -skipLibCheck",
    "lint": "eslint src"
  },
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@typescript-eslint/parser": "^8.67.0",
    "chokidar": "^3.6.0",
    "esbuild": "^0.21.5",
    "eslint": "^9.39.5",
    "eslint-plugin-obsidianmd": "^0.4.1",
    "obsidian": "latest",
    "typescript": "^5.5.4",
    "typescript-eslint": "^8.67.0"
  }
}
